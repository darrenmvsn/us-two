# Us Two on the shared Oracle VM. deploy.sh copies this to .env (chmod 600) on
# its first run and fills the generated secret; never commit .env.

# --- Generated by deploy.sh (required) ---------------------------------------
# Password of the `ustwo` role in Viralab's shared Postgres; create-db.sh
# applies it, docker-compose.yml builds DATABASE_URL from it. Letters, digits,
# _ and - only, at least 24 characters.
USTWO_DB_PASSWORD=

# --- Domain (optional until bought) ------------------------------------------
# Public hostname; its DNS record must point at the VM (through Cloudflare).
# Empty = deploy.sh skips the Caddy site block and the app is reachable only
# on the VM.
USTWO_DOMAIN=

# --- Product analytics (optional; unset = off, nothing sent) -----------------
# The PostHog project Viralab, DesignLoop and Moatlab share. Server-side only.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# --- Nudges: web push (optional; unset = off, not offered on any screen) -----
# Free: browsers deliver through their own push services with these keys.
# Make a pair once with `npx web-push generate-vapid-keys`; keep the private
# key secret and never change the pair (every phone would have to turn
# nudges on again). The subject is how push services contact us.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@useviralab.com

# --- Overrides (rarely needed) -----------------------------------------------
# VIRALAB_NETWORK=viralab_default
# VIRALAB_PROJECT=viralab
# VIRALAB_PG_SUPERUSER=viralab
# VIRALAB_PG_DATABASE=viralab
# VIRALAB_ORACLE_DIR=$HOME/viralab/MiroFish/deploy/oracle
# BACKUP_RETENTION_DAYS=14
